APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es_CL
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CL

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

CORS_ALLOWED_ORIGINS=*

CATALOG_HERO_PRE_HEADLINE="La Piojera de la Ely"
CATALOG_HERO_HEADLINE="Carta de la semana"
CATALOG_HERO_SUB_HEADLINE="Un plato distinto cada día en Tierra Amarilla, Región de Atacama. Cocina casera con sabor de barrio: consulta disponibilidad y precios al momento."
CATALOG_HERO_CTA_TEXT="Consultar o pedir"
CATALOG_HERO_CTA_URL="#contacto"

VITE_APP_NAME="${APP_NAME}"

# Pedidos por WhatsApp (catálogo público). Solo dígitos, ej. 56988132247. Vacío = sin botones.
WHATSAPP_ORDER_PHONE=56988132247

# Reserva: adelanto por transferencia (% del total del pedido)
RESERVATION_DEPOSIT_PERCENT=50

# Datos bancarios para transferencia (se muestran al cliente)
BANK_NAME=
BANK_ACCOUNT_TYPE=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_HOLDER=
BANK_ACCOUNT_RUT=
BANK_ACCOUNT_EMAIL=
